{
  "name": "harness-deck-launcher",
  "description": "harness-deck: harness registry and process launcher. One DSH profile (process, port, DSH_HOME) per registered harness \u2014 the shared base of paths A and B of docs/plano.md",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "harness-deck": "./bin/harness-deck.mjs"
  },
  "exports": {
    ".": "./src/registry.ts",
    "./registry": "./src/registry.ts",
    "./launcher": "./src/launcher.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings src/cli.ts",
    "test": "node --experimental-strip-types --no-warnings test/merge-patch.test.ts && node --experimental-strip-types --no-warnings test/workspaces.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --typeRoots ../harness-deck-claude-code/node_modules/@types"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
